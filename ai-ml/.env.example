# --- AI/ML ---
# Copy to ai-ml/.env and fill in. Get a free key (no credit card) at console.groq.com
# -> API Keys. Without a key the pipeline runs in a local fallback mode
# (deterministic hashing vectors + template task) so the demo works, but retrieval
# and condensing quality jump once GROQ_API_KEY is set.
#
# One key covers both LLM and embeddings (Groq is OpenAI-compatible).

GROQ_API_KEY=

# LLM (task condensing) — smartest model on Groq's free tier.
# Alternatives: openai/gpt-oss-20b (2x faster, a bit weaker), qwen/qwen3-32b.
LLM_MODEL=openai/gpt-oss-120b

# Embeddings run locally via fastembed (free, no key, ONNX). Model downloads once
# to ~/.cache/fastembed. Groq has no free embeddings API — see app/embeddings/embedder.py.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5