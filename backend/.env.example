# --- CALL-E (outbound AI voice calls) -----------------------------------------
# Get a key from the CALL-E dashboard at https://dashboard.heycall-e.com
# (new accounts start with 20 free calls).
CALLE_API_KEY=

# Production API (leave default). Prefer CALLE_BASE_URL=https://api.heycall-e.com
CALLE_BASE_URL=https://api.heycall-e.com

# Fallback region if caller's number doesn't map to a CALL-E supported region
CALLE_DEFAULT_FALLBACK_REGION=US

# --- Database ----------------------------------------------------------------
DATABASE_URL=sqlite:///./denwa.db

# --- Telephony webhook (Telnyx) -----------------------------------------------
# Account PUBLIC key: Mission Control Portal -> Account Settings ->
# Keys & Credentials -> Public Key. Used to verify Ed25519 webhook signatures.
TELNYX_PUBLIC_KEY=

WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
# Must stay false outside of local dev testing.
WEBHOOK_SKIP_SIGNATURE_CHECK=false

# --- Worker -------------------------------------------------------------------
# Start the background callback worker with the app (default true).
WORKER_ENABLED=true

# --- AI/ML (Groq — free key at console.groq.com) --------------------------------
# Used to condense retrieved knowledge into the CALL-E task. Without it the
# pipeline still runs in deterministic local-fallback mode.
GROQ_API_KEY=

# LLM for task condensing — smartest model on Groq's free tier.
# Alternatives: openai/gpt-oss-20b (2x faster), qwen/qwen3-32b.
LLM_MODEL=openai/gpt-oss-120b

# Embeddings run locally (fastembed ONNX if available, else numpy hashing fallback).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5